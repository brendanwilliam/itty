// Shared build settings for the iOS app. Signing and the bundle
// identifier come from Local.xcconfig, which is not checked in.
// Copy Local.xcconfig.example to Local.xcconfig to get started.
ITTY_BUNDLE_ID = com.example.itty
PRODUCT_BUNDLE_IDENTIFIER = $(ITTY_BUNDLE_ID)
PRODUCT_NAME = itty
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
#include? "Local.xcconfig"
